{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema=backend/prisma/schema.prisma",
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "start:dev": "tsx src/server.ts",
    "start:worker": "tsx src/worker.ts",
    "build": "npm run build -w frontend && npm run build -w backend",
    "prestart": "echo \"Skipping migrations during boot to prevent pooler hang\"",
    "start": "npm run start -w backend",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "npm run lint -w frontend --if-present && npm run lint -w backend --if-present",
    "test": "echo No tests configured",
    "build:frontend": "npm run build:frontend"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@react-google-maps/api": "^2.20.8",
    "@supabase/supabase-js": "^2.110.2",
    "@tailwindcss/vite": "^4.1.14",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.12",
    "compression": "^1.8.1",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csurf": "^1.11.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "express-winston": "^4.2.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "isomorphic-dompurify": "^3.19.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
