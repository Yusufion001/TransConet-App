generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
  schemas    = ["auth", "public"]
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  phoneNumber          String               @unique
  role                 UserRole             @default(CUSTOMER)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  phone                String?              @unique
  password             String               @default("")
  walletBalance        Float                @default(0.0)
  bids                 Bid[]
  loadPostings         LoadPosting[]
  shipperProfile       ShipperProfile?
  sentTransactions     Transaction[]        @relation("ShipperTransactions")
  receivedTransactions Transaction[]        @relation("TransporterTransactions")
  transporterProfile   TransporterProfile?
  vehicles             TransporterVehicle[]
  aiActions            TransConetAiAction[]

  @@schema("public")
}

model TransConetAiAction {
  id          String   @id @default(uuid())
  userId      String
  role        UserRole
  actionName  String
  status      AiActionStatus @default(PENDING_APPROVAL)
  payload     Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  approvedAt  DateTime?
  consumedAt  DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@schema("public")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model TransporterProfile {
  id                       String                       @id
  userId                   String                       @unique
  companyName              String?
  businessRegistrationNo   String?
  verificationLevel        VerificationLevel           @default(LEVEL_1)
  isVerified               Boolean                      @default(false)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  user                     User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles                 TransporterVehicle[]

  @@schema("public")
}

