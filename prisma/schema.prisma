model OutboxEvent {
  id        String   @id @default(uuid())
  type      String
  payload   Json
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payload(ops: JsonbPathOps)], type: Gin)
  @@schema("public")
}

enum AdminRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  COMPLIANCE_ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  DEVELOPER

  @@schema("public")
}

model AdminUser {
  id                  String          @id @default(uuid())
  email               String          @unique
  passwordHash        String
  role                AdminRole       @default(SUPPORT_ADMIN)
  twoFactorSecret     String?
  twoFactorEnabled    Boolean         @default(false)
  failedLoginAttempts Int             @default(0)
  lockoutUntil        DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  lastLoginDeviceId   String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  isActive            Boolean         @default(true)
  sessions            AdminSession[]
  auditLogs           AdminAuditLog[]

  @@schema("public")
}

model AdminSession {
  id          String   @id @default(uuid())
  adminUserId String
  token       String   @unique
  ipAddress   String?
  userAgent   String?
  deviceId    String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminUserId String?
  action      String
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([details(ops: JsonbPathOps)], type: Gin)
  @@schema("public")
}

model Transaction {
  id        String            @id @default(uuid())
  amount    Float
  type      TransactionType
  status    TransactionStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  loadId        String
  shipperId     String
  transporterId String

  load        LoadPosting @relation(fields: [loadId], references: [id])
  shipper     User        @relation("ShipperTransactions", fields: [shipperId], references: [id])
  transporter User        @relation("TransporterTransactions", fields: [transporterId], references: [id])

  @@schema("public")
}

enum TransactionType {
  ESCROW_RELEASE
  ESCROW_DEPOSIT
  PLATFORM_FEE
  WITHDRAWAL

  @@schema("public")
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED

  @@schema("public")
}

