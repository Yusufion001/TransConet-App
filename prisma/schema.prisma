generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  schemas    = ["auth", "public"]
  extensions = [postgis, vector]
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  phoneNumber          String               @unique
  role                 UserRole             @default(CUSTOMER)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  phone                String?              @unique
  password             String               @default("")
  walletBalance        Float                @default(0.0)
  sentTransactions     Transaction[]        @relation("ShipperTransactions")
  receivedTransactions Transaction[]        @relation("TransporterTransactions")
  bids                 Bid[]
  loadPostings         LoadPosting[]
  shipperProfile       ShipperProfile?
  transporterProfile   TransporterProfile?
  vehicles             TransporterVehicle[]

  @@schema("public")
}

model TransporterProfile {
  id                       String                       @id @default(uuid())
  userId                   String                       @unique
  companyName              String?
  bio                      String?
  isVerified               Boolean                      @default(false)
  isPremiumMember          Boolean                      @default(false)
  rating                   Float                        @default(0.0)
  vehicleType              VehicleType                  @default(HEAVY_DUTY)
  vehicleBrand             String                       @default("Unknown")
  tonnageCapacity          Float                        @default(0.0)
  operationalRoutes        String[]
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  cacCertificateUrl        String?
  cacStatusReportUrl       String?
  companyAddress           String?
  companyEmail             String?
  companyLogoUrl           String?
  companyPhone             String?
  documentStatus           DocumentStatus               @default(PENDING)
  driversLicenseUrl        String?
  fullName                 String                       @default("Unknown")
  identityUrl              String?
  letterOfAuthorizationUrl String?
  nextOfKinName            String?
  nextOfKinPhone           String?
  residentialAddress       String?
  role                     TransporterRole              @default(INDIVIDUAL_DRIVER)
  selfieUrl                String?
  taxIdentificationNumber  String?
  verificationLevel        TransporterVerificationLevel @default(LEVEL_1)
  verificationNotes        String?
  embedding                Unsupported("vector(768)")?
  assignedDrivers          AssignedDriver[]
  user                     User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles                 Vehicle[]

  @@schema("public")
}

model Vehicle {
  id                         String                                @id @default(uuid())
  transporterProfileId       String
  licensePlate               String                                @unique
  make                       String
  model                      String
  year                       Int
  capacityTons               Float
  currentLocation            Unsupported("geometry(Point, 4326)")?
  registrationCertificateUrl String
  proofOfOwnershipUrl        String
  vehicleLicenseUrl          String
  roadWorthinessUrl          String
  insuranceCertificateUrl    String
  inspectionReportUrl        String?
  photographs                String[]
  status                     DocumentStatus                        @default(PENDING)
  assignedDriverId           String?                               @unique
  createdAt                  DateTime                              @default(now())
  updatedAt                  DateTime                              @updatedAt
  assignedDriver             AssignedDriver?                       @relation(fields: [assignedDriverId], references: [id])
  transporter                TransporterProfile                    @relation(fields: [transporterProfileId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model AssignedDriver {
  id                   String             @id @default(uuid())
  transporterProfileId String
  fullName             String
  phoneNumber          String             @unique
  identityUrl          String
  driversLicenseUrl    String
  passportPhotoUrl     String
  medicalFitnessUrl    String?
  status               DocumentStatus     @default(PENDING)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  transporter          TransporterProfile @relation(fields: [transporterProfileId], references: [id], onDelete: Cascade)
  vehicle              Vehicle?

  @@schema("public")
}

model LoadPosting {
  id                  String                                @id @default(uuid())
  title               String
  cargoType           CargoType
  weightKg            Float
  origin              String
  destination         String
  originLocation      Unsupported("geometry(Point, 4326)")?
  destinationLocation Unsupported("geometry(Point, 4326)")?
  embedding           Unsupported("vector(768)")?
  suggestedBudget     Float?
  status              String                                @default("AVAILABLE")
  customerId          String
  createdAt           DateTime                              @default(now())
  updatedAt           DateTime                              @updatedAt
  isEscrowEnabled     Boolean                               @default(false)
  paymentStatus       String                                @default("PENDING")
  embeddingStatus     EmbeddingStatus                       @default(PENDING)
  embeddingRetries    Int                                   @default(0)
  escrowBalance       Float                                 @default(0.0)
  transactions        Transaction[]
  bids                Bid[]
  user                User                                  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@schema("public")
}

model PhoneVerification {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  otpCode     String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@schema("public")
}

model TransporterVehicle {
  id            String      @id @default(uuid())
  transporterId String
  brand         String
  vehicleType   VehicleType
  plateNumber   String      @unique
  capacityTons  Float
  isVerified    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [transporterId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Bid {
  id        String      @id @default(uuid())
  amount    Float
  notes     String?
  status    BidStatus   @default(PENDING)
  loadId    String
  driverId  String
  createdAt DateTime    @default(now())
  driver    User        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  load      LoadPosting @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@index([driverId])
  @@schema("public")
}

model ShipperProfile {
  id                       String                      @id @default(uuid())
  userId                   String                      @unique
  verificationLevel        VerificationLevel           @default(LEVEL_1)
  isBusinessVerified       Boolean                     @default(false)
  businessName             String?
  companyAddress           String?
  companyEmail             String?
  companyPhoneNumber       String?
  taxIdentificationNumber  String?
  companyLogoUrl           String?
  cacCertificateUrl        String?
  cacStatusReportUrl       String?
  cacDocumentStatus        DocumentStatus              @default(PENDING)
  representativeIdUrl      String?
  letterOfAuthorizationUrl String?
  representativeStatus     DocumentStatus              @default(PENDING)
  utilityBillUrl           String?
  proofOfBankOwnershipUrl  String?
  businessWebsiteUrl       String?
  insuranceCertificateUrl  String?
  verificationNotes        String?
  embedding                Unsupported("vector(768)")?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  user                     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model SupportTicket {
  id        String           @id @default(uuid())
  userId    String
  userPhone String
  category  String
  status    String           @default("OPEN")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@schema("public")
}

model SupportMessage {
  id         String        @id @default(uuid())
  ticketId   String
  sender     String
  senderName String        @default("User")
  content    String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Broadcast {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String   @default("ALL")
  source    String   @default("Admin")
  severity  String   @default("INFO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

